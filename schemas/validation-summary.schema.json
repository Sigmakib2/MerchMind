              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "verification_status": {
          "enum": [
            "merchant_provided",
            "unverified",
            "verified",
            "inferred"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "freshness_status": {
          "default": "unknown",
          "enum": [
            "current",
            "stale",
            "unknown"
          ],
          "title": "Freshness Status",
          "type": "string"
        },
        "hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "source_type",
        "source_record_ref",
        "retrieved_at",
        "assertion",
        "verification_status",
        "hash"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ValidationEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "event_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Event Id",
          "type": "string"
        },
        "study_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Study Id",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "title": "Profile Version",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Segment Id",
          "type": "string"
        },
        "hypothesis_field": {
          "enum": [
            "use_context",
            "possible_goals",
            "possible_buying_triggers",
            "possible_objections"
          ],
          "title": "Hypothesis Field",
          "type": "string"
        },
        "hypothesis_index": {
          "default": 0,
          "maximum": 9,
          "minimum": 0,
          "title": "Hypothesis Index",
          "type": "integer"
        },
        "method": {
          "enum": [
            "interview",
            "survey",
            "sample_test",
            "sales",
            "returns"
          ],
          "title": "Method",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "supports",
            "contradicts",
            "inconclusive"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "reviewed_by_merchant": {
          "const": true,
          "title": "Reviewed By Merchant",
          "type": "boolean"
        },
        "sample_size": {
          "exclusiveMinimum": 0,
          "title": "Sample Size",
          "type": "integer"
        },
        "notes": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Notes",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "supersedes_event_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Event Id"
        }
      },
      "required": [
        "event_id",
        "study_id",
        "profile_id",
        "profile_version",
        "segment_id",
        "hypothesis_field",
        "method",
        "outcome",
        "occurred_at",
        "recorded_at",
        "reviewed_by_merchant",
        "sample_size",
        "notes",
        "evidence_ids",
        "sources"
      ],
      "title": "ValidationEvent",
      "type": "object"
    },
    "ValidationFinding": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Segment Id",
          "type": "string"
        },
        "hypothesis_field": {
          "enum": [
            "use_context",
            "possible_goals",
            "possible_buying_triggers",
            "possible_objections"
          ],
          "title": "Hypothesis Field",
          "type": "string"
        },
        "hypothesis_index": {
          "title": "Hypothesis Index",
          "type": "integer"
        },
        "hypothesis": {
          "title": "Hypothesis",
          "type": "string"
        },
        "assessment": {
          "enum": [
            "untested",
            "some_support",
            "contradicted",
            "mixed",
            "inconclusive"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "supporting_studies": {
          "title": "Supporting Studies",
          "type": "integer"
        },
        "contradicting_studies": {
          "title": "Contradicting Studies",
          "type": "integer"
        },
        "inconclusive_studies": {
          "title": "Inconclusive Studies",
          "type": "integer"
        },
        "reported_sample_total": {
          "title": "Reported Sample Total",
          "type": "integer"
        },
        "event_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "methods": {
          "items": {
            "type": "string"
          },
          "title": "Methods",
          "type": "array"
        }
      },
      "required": [
        "segment_id",
        "hypothesis_field",
        "hypothesis_index",
        "hypothesis",
        "assessment",
        "supporting_studies",
        "contradicting_studies",
        "inconclusive_studies",
        "reported_sample_total",
        "event_ids",
        "methods"
      ],
      "title": "ValidationFinding",
      "type": "object"
    },
    "ValidationRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "event": {
          "$ref": "#/$defs/ValidationEvent"
        },
        "event_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Event Hash",
          "type": "string"
        },
        "saved_at": {
          "format": "date-time",
          "title": "Saved At",
          "type": "string"
        }
      },
      "required": [
        "event",
        "event_hash",
        "saved_at"
      ],
      "title": "ValidationRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "engine_version": {
      "default": "0.1.0",
      "title": "Engine Version",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "title": "Profile Version",
      "type": "string"
    },
    "summarized_at": {
      "format": "date-time",
      "title": "Summarized At",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ValidationFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ValidationRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "summarized_at",
    "findings",
    "records",
    "limitations"
  ],
  "title": "ValidationSummary",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merchmind.example/schemas/1.0/validation-summary.schema.json"
}
