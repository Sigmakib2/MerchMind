{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "approved_for_sample",
        "rejected",
        "sample_tested",
        "actual_order_outcome"
      ],
      "title": "Status",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "notes": {
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "status",
    "recorded_at",
    "notes"
  ],
  "title": "Feedback",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merchmind.example/schemas/1.0/feedback.schema.json"
}
