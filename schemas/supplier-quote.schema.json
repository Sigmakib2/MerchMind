          "type": "string"
        }
      },
      "required": [
        "min_qty",
        "unit_price",
        "currency"
      ],
      "title": "PriceTier",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supplier_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
      "title": "Supplier Id",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "listing_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Listing Url"
    },
    "product_variant_key": {
      "title": "Product Variant Key",
      "type": "string"
    },
    "price_tiers": {
      "items": {
        "$ref": "#/$defs/PriceTier"
      },
      "minItems": 1,
      "title": "Price Tiers",
      "type": "array"
    },
    "moq": {
      "exclusiveMinimum": 0,
      "title": "Moq",
      "type": "integer"
    },
    "mass_g": {
      "anyOf": [
        {
          "gt": 0,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mass G"
    },
    "packaging_mass_g": {
      "anyOf": [
        {
          "ge": 0,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Packaging Mass G"
    },
    "incoterm": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Incoterm"
    },
    "lead_time_days": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lead Time Days"
    },
    "quote_type": {
      "enum": [
        "advertised",
        "confirmed"
      ],
      "title": "Quote Type",
      "type": "string"
    },
    "quoted_at": {
      "format": "date-time",
      "title": "Quoted At",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "verification_flags": {
      "items": {
        "type": "string"
      },
      "title": "Verification Flags",
      "type": "array"
    },
    "verification_checks": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Verification Checks",
      "type": "object"
    }
  },
  "required": [
    "supplier_id",
    "source",
    "product_variant_key",
    "price_tiers",
    "moq",
    "quote_type",
    "quoted_at",
    "evidence_ids"
  ],
  "title": "SupplierQuote",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merchmind.example/schemas/1.0/supplier-quote.schema.json"
}
