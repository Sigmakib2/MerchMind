        "max_product_mass_g": {
          "default": "400",
          "gt": 0,
          "title": "Max Product Mass G",
          "type": "string"
        },
        "minimum_contribution_margin": {
          "default": "0.30",
          "ge": 0,
          "le": 1,
          "title": "Minimum Contribution Margin",
          "type": "string"
        },
        "require_positive_conservative_margin": {
          "default": true,
          "title": "Require Positive Conservative Margin",
          "type": "boolean"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "Finance": {
      "additionalProperties": false,
      "properties": {
        "fx_policy": {
          "const": "dated_source_required",
          "default": "dated_source_required",
          "title": "Fx Policy",
          "type": "string"
        },
        "import_tax_policy": {
          "const": "manual_verified_input",
          "default": "manual_verified_input",
          "title": "Import Tax Policy",
          "type": "string"
        },
        "merchant_vat_treatment": {
          "default": "unknown",
