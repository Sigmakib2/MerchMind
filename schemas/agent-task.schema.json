    "NicheBrief": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "brief_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Brief Id",
          "type": "string"
        },
        "merchant_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Merchant Id",
          "type": "string"
        },
        "niche": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Niche",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "market_country": {
          "title": "Market Country",
          "type": "string"
        },
        "audience_context": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Audience Context",
          "type": "array"
        },
        "product_constraints": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Product Constraints",
          "type": "array"
        },
        "sourcing_hosts": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Sourcing Hosts",
          "type": "array"
        },
        "research_languages": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Research Languages",
          "type": "array"
        },
        "segment_count": {
          "default": 4,
          "enum": [
            3,
            4
          ],
          "title": "Segment Count",
          "type": "integer"
        }
      },
      "required": [
        "brief_id",
        "merchant_id",
        "niche",
        "description",
        "market_country"
      ],
      "title": "NicheBrief",
      "type": "object"
    },
    "Permissions": {
      "additionalProperties": false,
      "properties": {
        "read_only_research": {
          "const": true,
          "default": true,
          "title": "Read Only Research",
          "type": "boolean"
        },
        "outbound_messages": {
          "const": false,
          "default": false,
          "title": "Outbound Messages",
          "type": "boolean"
        },
        "purchasing": {
          "const": false,
          "default": false,
          "title": "Purchasing",
          "type": "boolean"
        }
      },
      "title": "Permissions",
      "type": "object"
    },
    "ResearchPolicy": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "max_requests_per_domain": {
          "default": 3,
          "maximum": 50,
          "minimum": 2,
          "title": "Max Requests Per Domain",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 1000000,
          "maximum": 10000000,
          "minimum": 1024,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "max_sources": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Sources",
          "type": "integer"
        },
        "max_duration_minutes": {
          "default": 30,
          "maximum": 60,
          "minimum": 1,
          "title": "Max Duration Minutes",
          "type": "integer"
        },
        "max_report_bytes": {
          "default": 10000000,
          "maximum": 100000000,
          "minimum": 1024,
          "title": "Max Report Bytes",
          "type": "integer"
        }
      },
      "title": "ResearchPolicy",
      "type": "object"
    }
