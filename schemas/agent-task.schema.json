  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
      "title": "Task Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "brief": {
      "$ref": "#/$defs/NicheBrief"
    },
    "merchant_snapshot": {
      "$ref": "#/$defs/Merchant"
    },
    "policy_snapshot": {
      "$ref": "#/$defs/ResearchPolicy"
    },
    "research_plan": {
      "additionalProperties": true,
      "title": "Research Plan",
      "type": "object"
    },
    "source_scope": {
      "default": "approved_hosts",
      "enum": [
        "approved_hosts",
        "public_web"
      ],
      "title": "Source Scope",
      "type": "string"
    },
    "allowed_hosts": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Allowed Hosts",
      "type": "array"
    },
    "required_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Required Capabilities",
      "type": "array"
    },
    "instructions": {
      "items": {
        "type": "string"
      },
      "title": "Instructions",
      "type": "array"
    },
    "integrity_hash": {
      "default": "",
      "title": "Integrity Hash",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "created_at",
    "expires_at",
    "brief",
    "merchant_snapshot",
    "policy_snapshot",
    "research_plan",
    "instructions"
  ],
  "title": "AgentResearchTask",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merchmind.example/schemas/1.0/agent-task.schema.json"
