        "minimum_contribution_margin": {
          "default": "0.30",
          "ge": 0,
          "le": 1,
          "title": "Minimum Contribution Margin",
          "type": "string"
        },
        "require_positive_conservative_margin": {
          "default": true,
          "title": "Require Positive Conservative Margin",
          "type": "boolean"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "Finance": {
      "additionalProperties": false,
      "properties": {
        "fx_policy": {
          "const": "dated_source_required",
