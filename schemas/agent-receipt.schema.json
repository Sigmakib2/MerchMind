{
  "$defs": {
    "AgentActivity": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "search",
            "browse",
            "synthesize"
          ],
          "title": "Action",
          "type": "string"
        },
        "performed_at": {
          "format": "date-time",
          "title": "Performed At",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 1500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        }
      },
      "required": [
        "action",
        "performed_at"
      ],
      "title": "AgentActivity",
      "type": "object"
    },
    "AgentCapture": {
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Capture Id",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Uri"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 10000,
          "minLength": 10,
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "capture_id",
        "source_uri",
        "retrieved_at",
        "title",
        "excerpt"
      ],
      "title": "AgentCapture",
      "type": "object"
    },
    "AgentResearchTask": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Task Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "brief": {
          "$ref": "#/$defs/NicheBrief"
        },
        "merchant_snapshot": {
          "$ref": "#/$defs/Merchant"
        },
        "policy_snapshot": {
          "$ref": "#/$defs/ResearchPolicy"
        },
        "research_plan": {
          "additionalProperties": true,
          "title": "Research Plan",
          "type": "object"
        },
        "source_scope": {
          "default": "approved_hosts",
          "enum": [
            "approved_hosts",
            "public_web"
          ],
          "title": "Source Scope",
          "type": "string"
        },
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Allowed Hosts",
          "type": "array"
        },
        "required_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "instructions": {
          "items": {
            "type": "string"
          },
          "title": "Instructions",
          "type": "array"
        },
        "integrity_hash": {
          "default": "",
          "title": "Integrity Hash",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "created_at",
        "expires_at",
        "brief",
        "merchant_snapshot",
        "policy_snapshot",
        "research_plan",
        "instructions"
      ],
      "title": "AgentResearchTask",
      "type": "object"
    },
    "AgentSubmission": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Task Id",
          "type": "string"
        },
        "brief_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Brief Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "runtime": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Runtime",
          "type": "string"
        },
        "tools_used": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Tools Used",
          "type": "array"
        },
        "captures": {
          "items": {
            "$ref": "#/$defs/AgentCapture"
          },
          "maxItems": 100,
          "title": "Captures",
          "type": "array"
        },
        "activities": {
          "items": {
            "$ref": "#/$defs/AgentActivity"
          },
          "maxItems": 500,
          "title": "Activities",
          "type": "array"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/SegmentHypothesis"
          },
          "maxItems": 4,
          "title": "Segments",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "brief_id",
        "status",
        "runtime"
      ],
      "title": "AgentSubmission",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "max_product_mass_g": {
          "default": "400",
          "gt": 0,
          "title": "Max Product Mass G",
          "type": "string"
        },
        "minimum_contribution_margin": {
          "default": "0.30",
          "ge": 0,
          "le": 1,
          "title": "Minimum Contribution Margin",
          "type": "string"
        },
        "require_positive_conservative_margin": {
          "default": true,
          "title": "Require Positive Conservative Margin",
          "type": "boolean"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
