{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Finding Id",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "kind": {
          "enum": [
            "observation",
            "merchant_hypothesis",
            "inference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "counterevidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "type": "string"
          },
          "title": "Counterevidence Ids",
          "type": "array"
        },
        "last_reviewed_at": {
          "format": "date-time",
          "title": "Last Reviewed At",
          "type": "string"
        },
        "adopted": {
          "const": false,
          "default": false,
          "title": "Adopted",
          "type": "boolean"
        }
      },
      "required": [
        "finding_id",
        "segment_id",
        "statement",
        "kind",
        "confidence",
        "evidence_ids",
        "last_reviewed_at"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "merchant_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
      "title": "Merchant Id",
      "type": "string"
    },
    "built_at": {
      "format": "date-time",
      "title": "Built At",
      "type": "string"
    },
    "profile_version": {
      "title": "Profile Version",
      "type": "string"
    },
    "metrics": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Metrics",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "merchant_id",
    "built_at",
    "profile_version",
    "metrics",
    "findings",
    "limitations",
    "evidence_ids"
  ],
  "title": "CustomerProfile",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merchmind.example/schemas/1.0/customer-profile.schema.json"
}
