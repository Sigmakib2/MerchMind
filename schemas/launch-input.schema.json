{
  "$defs": {
    "CostInput": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "merchant_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Merchant Id",
          "type": "string"
        },
        "product_variant_key": {
          "title": "Product Variant Key",
          "type": "string"
        },
        "origin_country": {
          "title": "Origin Country",
          "type": "string"
        },
        "destination_country": {
          "title": "Destination Country",
          "type": "string"
        },
        "fx": {
          "$ref": "#/$defs/FX"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/CostScenario"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Scenarios",
          "type": "array"
        }
      },
      "required": [
        "merchant_id",
        "product_variant_key",
        "origin_country",
        "destination_country",
        "fx",
        "evidence_ids",
        "scenarios"
      ],
      "title": "CostInput",
      "type": "object"
    },
    "CostScenario": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "optimistic",
            "base",
            "conservative"
          ],
          "title": "Name",
          "type": "string"
        },
        "unit_price_source": {
          "gt": 0,
          "title": "Unit Price Source",
          "type": "string"
        },
        "mass_g": {
          "anyOf": [
            {
              "gt": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mass G"
        },
        "packaging_mass_g": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packaging Mass G"
        },
        "mass": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "packaging_mass": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "volumetric_mass_g": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volumetric Mass G"
        },
        "fixed_sourcing_per_unit": {
          "default": "0",
          "ge": 0,
          "title": "Fixed Sourcing Per Unit",
          "type": "string"
        },
        "import_duties": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Import Duties"
        },
        "import_vat": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Import Vat"
        },
        "tax_inputs_confirmed": {
          "default": false,
          "title": "Tax Inputs Confirmed",
          "type": "boolean"
        },
        "tax_evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "type": "string"
          },
          "title": "Tax Evidence Ids",
          "type": "array"
        },
        "brokerage": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Brokerage"
        },
        "local_inbound": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Inbound"
        },
        "other_import_costs": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Other Import Costs"
        },
        "selling_price_net": {
          "gt": 0,
          "title": "Selling Price Net",
          "type": "string"
        },
        "packaging": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Packaging"
        },
        "fulfillment": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fulfillment"
        },
        "payment_fee": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Payment Fee"
        },
        "marketing_cost": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Marketing Cost"
        },
        "expected_return_loss": {
          "anyOf": [
            {
              "ge": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Return Loss"
        }
      },
      "required": [
        "name",
        "unit_price_source",
        "import_duties",
        "import_vat",
        "brokerage",
        "local_inbound",
        "other_import_costs",
        "selling_price_net",
        "packaging",
        "fulfillment",
        "payment_fee",
        "marketing_cost",
        "expected_return_loss"
      ],
      "title": "CostScenario",
      "type": "object"
    },
