{
  "$defs": {
    "CandidateProduct": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Product Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "variant": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Variant",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "mass_g": {
          "anyOf": [
            {
              "gt": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mass G"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/ProductFact"
          },
          "maxItems": 50,
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "name",
        "variant",
        "category",
        "mass_g"
      ],
      "title": "CandidateProduct",
      "type": "object"
    },
    "ComparisonInput": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "title": "Profile Version",
          "type": "string"
        },
        "products": {
          "items": {
            "$ref": "#/$defs/CandidateProduct"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Products",
          "type": "array"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/FitCriterion"
          },
          "maxItems": 80,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 100,
          "title": "Sources",
          "type": "array"
        },
        "minimum_coverage": {
          "default": "0.60",
          "ge": 0,
          "le": 1,
          "title": "Minimum Coverage",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "products",
        "criteria"
      ],
      "title": "ComparisonInput",
      "type": "object"
    },
    "CriterionMatch": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "original_hypothesis": {
          "title": "Original Hypothesis",
          "type": "string"
        },
        "status": {
          "enum": [
            "match",
            "mismatch",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "expected_value": {
          "title": "Expected Value",
          "type": "string"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Value"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "description",
        "original_hypothesis",
        "status",
        "expected_value",
        "observed_value",
        "evidence_ids",
        "reason"
      ],
      "title": "CriterionMatch",
      "type": "object"
    },
