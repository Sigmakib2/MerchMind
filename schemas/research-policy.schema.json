    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "max_requests_per_domain": {
      "default": 3,
      "maximum": 50,
      "minimum": 2,
      "title": "Max Requests Per Domain",
      "type": "integer"
    },
    "max_response_bytes": {
      "default": 1000000,
      "maximum": 10000000,
