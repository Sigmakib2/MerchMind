      "type": "integer"
    },
    "max_duration_minutes": {
      "default": 30,
      "maximum": 60,
      "minimum": 1,
      "title": "Max Duration Minutes",
      "type": "integer"
    },
    "max_report_bytes": {
      "default": 10000000,
      "maximum": 100000000,
      "minimum": 1024,
      "title": "Max Report Bytes",
      "type": "integer"
    }
  },
  "title": "ResearchPolicy",
  "type": "object",
