{
  "$defs": {
    "CandidateProduct": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Product Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "variant": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Variant",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "mass_g": {
          "anyOf": [
            {
              "gt": 0,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mass G"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/ProductFact"
          },
          "maxItems": 50,
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "name",
        "variant",
        "category",
        "mass_g"
      ],
      "title": "CandidateProduct",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "merchant_record",
            "manufacturer",
            "supplier_quote",
            "marketplace_listing",
            "independent_review",
            "government",
            "inference",
            "web_search_result",
            "agent_web_capture"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "source_record_ref": {
          "title": "Source Record Ref",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "assertion": {
          "title": "Assertion",
          "type": "string"
        },
        "captured_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured Value"
        },
        "currency": {
