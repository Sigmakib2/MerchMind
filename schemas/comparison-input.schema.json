              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "verification_status": {
          "enum": [
            "merchant_provided",
            "unverified",
            "verified",
            "inferred"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "freshness_status": {
          "default": "unknown",
          "enum": [
            "current",
            "stale",
            "unknown"
          ],
          "title": "Freshness Status",
          "type": "string"
        },
        "hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "source_type",
        "source_record_ref",
        "retrieved_at",
        "assertion",
        "verification_status",
        "hash"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FitCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Segment Id",
          "type": "string"
        },
        "hypothesis_field": {
          "enum": [
            "use_context",
            "possible_goals",
            "possible_buying_triggers",
            "possible_objections"
          ],
          "title": "Hypothesis Field",
          "type": "string"
        },
        "hypothesis_index": {
          "default": 0,
          "maximum": 9,
          "minimum": 0,
          "title": "Hypothesis Index",
          "type": "integer"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Description",
          "type": "string"
        },
        "product_attribute": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Product Attribute",
          "type": "string"
        },
        "operator": {
          "enum": [
            "equals",
            "contains",
            "lte",
            "gte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "expected_value": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Expected Value",
          "type": "string"
        },
        "weight": {
          "default": "1",
          "gt": 0,
          "title": "Weight",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "segment_id",
        "hypothesis_field",
        "description",
        "product_attribute",
        "operator",
        "expected_value"
      ],
      "title": "FitCriterion",
      "type": "object"
    },
    "ProductFact": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Attribute",
          "type": "string"
        },
        "value": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "attribute",
        "value",
        "evidence_ids"
      ],
      "title": "ProductFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "title": "Profile Version",
      "type": "string"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/CandidateProduct"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Products",
      "type": "array"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/FitCriterion"
      },
      "maxItems": 80,
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 100,
      "title": "Sources",
      "type": "array"
    },
    "minimum_coverage": {
      "default": "0.60",
      "ge": 0,
      "le": 1,
      "title": "Minimum Coverage",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "products",
    "criteria"
  ],
  "title": "ComparisonInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merchmind.example/schemas/1.0/comparison-input.schema.json"
}
