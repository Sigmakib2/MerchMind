      "type": "string"
    },
    "freshness_status": {
      "default": "unknown",
      "enum": [
        "current",
        "stale",
        "unknown"
      ],
      "title": "Freshness Status",
      "type": "string"
    },
    "hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Hash",
      "type": "string"
    },
    "supporting_evidence_ids": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
        "type": "string"
      },
      "title": "Supporting Evidence Ids",
      "type": "array"
    }
