{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "merchant_record",
            "manufacturer",
            "supplier_quote",
            "marketplace_listing",
            "independent_review",
            "government",
            "inference",
            "web_search_result"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "source_record_ref": {
          "title": "Source Record Ref",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "assertion": {
          "title": "Assertion",
          "type": "string"
        },
        "captured_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured Value"
        },
        "currency": {
